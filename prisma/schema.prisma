// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_DIRECT_URL")
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

model User {
  id             String          @id @default(cuid())
  username       String          @unique // Email for Admin/Guru, NISN for Siswa
  password       String
  name           String?
  role           Role            @default(STUDENT)
  studentProfile Student?
  teacherProfile Teacher?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model Student {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  nisn         String   @unique
  nis          String?
  nik          String?
  gender       String?  // "L" or "P"
  tempatLahir  String?
  tanggalLahir String?
  alamat       String?
  namaAyah     String?
  namaIbu      String?
  noHpOrangTua String?
  asalSD       String?
  tahunMasuk   String?
  status       String   @default("Aktif") // "Aktif" or "Non-Aktif"
  
  kelasId      String?
  kelas        Kelas?   @relation(fields: [kelasId], references: [id])

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tugasSubmissions TugasSubmission[]
  absensi          Absensi[]
}

model Teacher {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  nip          String?  @unique
  nik          String?
  gender       String?
  tempatLahir  String?
  tanggalLahir String?
  alamat       String?
  noHp         String?
  pendidikan   String?
  status       String   @default("PNS") // "PNS", "GTT", "Honor"

  mapelId      String?
  mataPelajaran MataPelajaran? @relation(fields: [mapelId], references: [id])

  pengampu     Pengampu[]     @relation("TeacherPengampu")
  waliKelasDi  Kelas[]        @relation("WaliKelas")
  
  materi       Materi[]
  tugas        Tugas[]
  absensi      Absensi[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model MataPelajaran {
  id        String   @id @default(cuid())
  nama      String   @unique
  kode      String?  @unique
  kategori  String?  // e.g. "umum", "agama", "kejuruan"
  teachers  Teacher[]
  pengampu  Pengampu[]
  materi    Materi[]
  tugas     Tugas[]
  absensi   Absensi[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Kelas {
  id          String     @id @default(cuid())
  nama        String     @unique
  tingkat     String?    // "X", "XI", "XII"
  
  waliKelasId String?
  waliKelas   Teacher?   @relation("WaliKelas", fields: [waliKelasId], references: [id])

  students    Student[]
  pengampu    Pengampu[]
  materi      Materi[]
  tugas       Tugas[]
  absensi     Absensi[]

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Pengampu {
  id            String         @id @default(cuid())
  
  teacherId     String
  teacher       Teacher        @relation("TeacherPengampu", fields: [teacherId], references: [id])
  
  mapelId       String
  mapel         MataPelajaran  @relation(fields: [mapelId], references: [id])
  
  kelasId       String
  kelas         Kelas          @relation(fields: [kelasId], references: [id])
  
  tahunAjaranId String
  tahunAjaran   TahunAjaran    @relation(fields: [tahunAjaranId], references: [id])
  
  hari          String?        // e.g. "Senin", "Selasa"
  jamMulai      String?        // e.g. "07:00"
  jamSelesai    String?        // e.g. "08:30"

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([teacherId, mapelId, kelasId, tahunAjaranId])
}

model TahunAjaran {
  id        String   @id @default(cuid())
  tahun     String   // e.g., "2023/2024"
  semester  String   // e.g., "Ganjil" or "Genap"
  isActive  Boolean  @default(false)
  
  pengampu  Pengampu[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tahun, semester])
}

model Materi {
  id           String   @id @default(cuid())
  judul        String
  deskripsi    String?
  fileUrl      String?
  
  teacherId    String
  teacher      Teacher  @relation(fields: [teacherId], references: [id])
  
  mapelId      String
  mapel        MataPelajaran @relation(fields: [mapelId], references: [id])
  
  kelasId      String
  kelas        Kelas    @relation(fields: [kelasId], references: [id])
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Tugas {
  id           String   @id @default(cuid())
  judul        String
  deskripsi    String?
  fileUrl      String?
  dueDate      DateTime?
  
  teacherId    String
  teacher      Teacher  @relation(fields: [teacherId], references: [id])
  
  mapelId      String
  mapel        MataPelajaran @relation(fields: [mapelId], references: [id])
  
  kelasId      String
  kelas        Kelas    @relation(fields: [kelasId], references: [id])
  
  submissions  TugasSubmission[]
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model TugasSubmission {
  id           String   @id @default(cuid())
  tugasId      String
  tugas        Tugas    @relation(fields: [tugasId], references: [id])
  
  studentId    String
  student      Student  @relation(fields: [studentId], references: [id])
  
  fileUrl      String?
  nilai        Int?
  feedback     String?
  
  submittedAt  DateTime @default(now())
  
  @@unique([tugasId, studentId])
}

model Absensi {
  id           String   @id @default(cuid())
  tanggal      DateTime @default(now())
  status       String   // "Hadir", "Izin", "Sakit", "Alpha"
  keterangan   String?
  
  studentId    String
  student      Student  @relation(fields: [studentId], references: [id])
  
  kelasId      String
  kelas        Kelas    @relation(fields: [kelasId], references: [id])
  
  mapelId      String
  mapel        MataPelajaran @relation(fields: [mapelId], references: [id])
  
  teacherId    String
  teacher      Teacher  @relation(fields: [teacherId], references: [id])

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
